FROM node:24-slim

RUN apt-get update && apt-get install -y \
  ffmpeg \
  python3 \
  python3-pip \
  && pip3 install --no-cache-dir --break-system-packages -U --pre "yt-dlp[default]" \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

# yt-dlp needs a JS runtime for YouTube; reuse the image's Node instead of installing Deno
RUN printf -- '--js-runtimes node\n' > /etc/yt-dlp.conf

WORKDIR /app

RUN corepack enable

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

ENV NODE_ENV=production

EXPOSE 3333

CMD ["pnpm", "start"]