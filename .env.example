# Copy to .env and fill in. On Vercel, set the same variables in Project Settings → Environment Variables.

# Port the server listens on. Vercel's container runtime defaults to 80, so set PORT=3333 there too.
PORT=3333

# Send YouTube cookies to yt-dlp (true/false, default false). Turn on if YouTube blocks the server
# ("Sign in to confirm you're not a bot" / 403). Export cookies from a private/incognito window
# and close it right after, or YouTube rotates them.
YTDLP_USE_COOKIES=false
# Cookie source: the Netscape cookie file as a single-line base64 string (use this on Vercel).
# If unset, src/cookies.txt is used instead (git- and docker-ignored). Generate with:
#   base64 -i src/cookies.txt | tr -d '\n' | pbcopy
# YTDLP_COOKIES_BASE64=

# --- Upstash Redis (job state) ---
# console.upstash.com → Create Database (Redis) → "REST API" section
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# --- Cloudflare R2 (downloaded files) ---
# Account ID: Cloudflare dashboard → R2 → Overview (right side panel)
R2_ACCOUNT_ID=
# R2 → Manage API tokens → Create API token, permission "Object Read & Write", limited to the bucket below
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket name. Add a lifecycle rule in R2 → bucket → Settings → Object lifecycle rules:
# delete objects with prefix "downloads/" after 1 day (otherwise files are never removed)
R2_BUCKET=yt-download
# Optional, local dev only: use an S3-compatible server (e.g. MinIO at http://localhost:9000) instead of R2
# R2_ENDPOINT=

